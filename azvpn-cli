HERE = Path(__file__).resolve().parent
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "azvpn-cli"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "azvpn-cli"

REDIRECT_PORT = 2023  # must be a registered redirect URI on the app registration
REDIRECT_URI = f"http://localhost:{REDIRECT_PORT}"
DEFAULT_CA = HERE / "DigiCert_Global_Root_CA.crt"


def log(msg: str) -> None:
    print(f"==> {msg}", file=sys.stderr)


def die(msg: str, code: int = 1):
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def write_private(path: Path, data: str) -> None:
    """Create 0600 *before* the content lands in the file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(data)


